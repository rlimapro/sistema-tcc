# Copie para .env e preencha. O .env nunca vai para o git.
# Todos os comandos aceitam --env-file para escolher outro arquivo; o arquivo
# escolhido SOBRESCREVE as variáveis do ambiente, e a URI efetiva sai no log.
# Atenção: não escreva comentário na mesma linha de um valor vazio
# (o python-dotenv leria o comentário como valor).

# Neo4j do v3 (docker compose up -d neo4j). Portas próprias: 7484 (HTTP) e 7699 (Bolt).
NEO4J_URI=bolt://localhost:7699
NEO4J_USER=neo4j
# Obrigatório, sem default; mínimo de 8 caracteres.
NEO4J_PASSWORD=

# Neo4j de TESTE (docker compose --profile teste up -d neo4j-teste). Efêmero, sem volume.
# A senha de teste é fixa e não secreta; os testes recusam um banco que não esteja vazio.
NEO4J_TEST_URI=bolt://localhost:7700
NEO4J_TEST_PASSWORD=sarc-teste-local

# TCE-CE SIM
TCE_BASE_URL=https://api-dados-abertos.tce.ce.gov.br/sim
# Cache gravável do v3.
TCE_CACHE_PATH=./data/raw/tce_sim
# Cache adicional opcional, SOMENTE LEITURA (mesmo formato do cache principal).
# Vários separados por ":". Se a pasta não existir, é ignorada e o que faltar vem da API.
TCE_CACHE_EXTRA=./data/raw/tce_sim_v2
# Máximo aceito pela API.
TCE_PAGE_SIZE=1000
# Segundos entre chamadas (rate limit).
TCE_REQUEST_DELAY=0.3
TCE_TIMEOUT_CONNECT=10
TCE_TIMEOUT_READ=60

# Receita Federal: pasta que guarda os snapshots, um por subpasta AAAA-MM (ex.: data/rfb/2026-10/), cada um com
# Empresas0..9, Estabelecimentos0..9, Socios0..9 e Municipios (extraídos, ou só os ZIPs do portal; ver
# `sarc etl-rfb --extrair`). Também aceita o caminho direto de um snapshot. Ver README.md.
RFB_DATA_PATH=./data/rfb
# Mês do snapshot (AAAA-MM). Vazio = a subpasta mais recente de RFB_DATA_PATH; o snapshot em uso sai no log.
RFB_SNAPSHOT=
RFB_CHUNK_SIZE=50000

# Contato com grau nacional igual ou maior que isto vai para o nível auxiliar (T14).
GRAU_MAXIMO_CONTATO=5

# Logging. O log vai para stderr (o stdout fica livre para o MCP via stdio).
LOG_LEVEL=INFO
# Vazio = sem arquivo de log.
LOG_FILE=

# Auditoria do MCP: toda chamada de tool vira uma linha em <AUDITORIA_DIR>/chamadas-AAAA-MM-DD.jsonl
# (D-45), e cada chamada a cypher_somente_leitura também um registro completo em
# <AUDITORIA_DIR>/cypher-AAAA-MM-DD.jsonl (D-44). Absoluto vale como está; relativo é resolvido a partir da raiz
# do mvp-v3 (NÃO da pasta de onde o servidor roda: o cliente MCP pode subi-lo com qualquer cwd).
# Vazio = <raiz do mvp-v3>/logs/auditoria.
AUDITORIA_DIR=
